# architecture_decision("one-mirror-prefill-jit", reason="BS=1 contiguous mirror and multi-BS segmented mirror share one launched JIT. Runtime metadata selects tile boundaries; the Q request loop and K tile loop are valid in both modes. Runtime scalars cannot enter the specialization key.")
# optimization_point("shared-contiguous-aiv-schedule", skill_point="mixed_strategy", reason="Both mirror modes cap their one-dimensional grid at detected AIVs and give each program consecutive Q-request and K-tile intervals.")

sketch welmv4_inplace_rope_mirror_prefill {
  symbols {
    N: runtime_do_not_specialize
    BS: runtime_do_not_specialize
    NUM_WORK_TILES: runtime_do_not_specialize
    Q_TOKEN_STRIDE: runtime_do_not_specialize
    K_TOKEN_STRIDE: runtime_do_not_specialize
    HAS_SEGMENTS: runtime_do_not_specialize in {0, 1}
    AIV: runtime_host_constant
    HEAD_DIM: fixed_model_literal = 256
    ROPE_DIM: fixed_model_literal = 64
    HALF_ROPE: fixed_model_literal = 32
    Q_HEADS: fixed_model_literal = 6
    TOKEN_BLOCK: fixed_model_literal = 64
  }

  tensors {
    q: bf16[BS, 6, 256] inplace
    k: bf16[N, 1, 256] inplace
    positions: int64[N]
    cos_sin_cache: fp32[max_position, 64]
    last_index: int64[BS]
    segment_tile_starts: int32[NUM_WORK_TILES + 1] or stable_placeholder
  }

  constraints {
    q row b uses positions[last_index[b]]
    packed requests and last_index entries are valid
    when HAS_SEGMENTS == 0:
      BS = 1
      NUM_WORK_TILES = ceil_div(N, 64)
      positions are contiguous over all N tokens
      segment_tile_starts is not dereferenced
    when HAS_SEGMENTS == 1:
      each segment tile is request-local, length in [1, 64]
      positions are contiguous inside each tile
  }

  partition {
    grid = min(max(NUM_WORK_TILES, BS), detected_AIV)
    REQUESTS_PER_PROGRAM = ceil_div(BS, grid)
    request_begin = program_id(0) * REQUESTS_PER_PROGRAM
    request_end = min(request_begin + REQUESTS_PER_PROGRAM, BS)
    TILES_PER_PROGRAM = ceil_div(NUM_WORK_TILES, grid)
    tile_begin = program_id(0) * TILES_PER_PROGRAM
    tile_end = min(tile_begin + TILES_PER_PROGRAM, NUM_WORK_TILES)
  }

  each request_id in range(request_begin, request_end) {
    q_source = int32(last_index[request_id])
    q_position = int32(positions[q_source])
    load q_cos/q_sin from the FP32 cache
    rotate all six Q tails in FP32 and store BF16 in place
  }

  pipeline each tile_id in range(tile_begin, tile_end) stages 1 auto_multibuffer {
    runtime when HAS_SEGMENTS != 0:
      token_base/end = segment_tile_starts[tile_id:tile_id+2]
    runtime otherwise:
      token_base = tile_id * 64
      token_end = min(token_base + 64, N)

    position_base = int32(positions[token_base])
    position_ids = position_base + arange(0, 64)
    runtime full tile:
      rotate K with unmasked regular [64,32] 2D DMA
    runtime partial tile:
      rotate K with token_count mask
  }
}

# Layer1 self-check: There is one mirror Prefill launch function. N, BS, work-tile count, both token strides, and HAS_SEGMENTS are normal int arguments and exactly match do_not_specialize. No shape-derived tl.constexpr or masked meta-parameter exists. Every Q row and K token has exactly one writer, and both modes preserve the same FP32 RoPE arithmetic.

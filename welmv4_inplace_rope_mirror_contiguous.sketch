# architecture_decision("isolate-single-request-mirror", reason="The optimized ordinary/segmented prefill and generic decode/mirror kernels are frozen regression groups. This candidate is selectable only when Q rows=BS=1, K rows=N, last_index is present, head shapes are 6/1 x 256, rope_dim=64, and the host has already proved a single non-speculative extend request with contiguous positions.")
# optimization_point("continuous-aiv-partition-and-token-tiling", skill_point="tiling_optimization", reason="The generic mirror path launches hundreds of programs and processes K one token at a time with interleaved ownership. Partition the 64-token K tiles into at most the physical AIV count contiguous intervals, so every core issues monotonic regular 2D transfers. This is the only latency-skill optimization applied in round 1.")

sketch welmv4_inplace_rope_contiguous_mirror {
  symbols {
    N: runtime_do_not_specialize
    NUM_TOKEN_BLOCKS: runtime_do_not_specialize = ceil_div(N, TOKEN_BLOCK)
    AIV: runtime_host_constant
    BS: semantic_constant = 1
    Q_HEADS: constexpr = 6
    K_HEADS: constexpr = 1
    HEAD_DIM: constexpr = 256
    ROPE_DIM: constexpr = 64
    HALF_ROPE: constexpr = 32
    TOKEN_BLOCK: constexpr = 64
    PIPELINE_STAGES: constexpr = 1
  }

  tensors {
    q: bf16[1, Q_HEADS, HEAD_DIM] inplace contiguous
    k: bf16[N, K_HEADS, HEAD_DIM] inplace contiguous
    positions: int64[N] contiguous_values
    cos_sin_cache: fp32[max_position, ROPE_DIM]
    last_index: int64[1]
  }

  constraints {
    positions[i] = positions[0] + i for 0 <= i < N
    0 <= last_index[0] < N
    q uses positions[last_index[0]]
    k token i uses positions[i]
    N in {8192, 9616, 16361, 16384} for the first benchmark suite
    no dispatch or implementation change to ordinary_prefill, segmented_prefill,
      decode, or generic multi-request mirror
  }

  partition k_tiles_contiguously {
    grid = min(NUM_TOKEN_BLOCKS, AIV)
    BLOCKS_PER_PROGRAM = ceil_div(NUM_TOKEN_BLOCKS, grid)
    program_block_begin = program_id(0) * BLOCKS_PER_PROGRAM
    program_block_end = min(program_block_begin + BLOCKS_PER_PROGRAM,
                            NUM_TOKEN_BLOCKS)
  }

  once when program_id(0) == 0 {
    load q_source_i64 = last_index[0]
    cast q_source = int32(q_source_i64)
    load q_position_i64 = positions[q_source]
    cast q_position = int32(q_position_i64)
    load q_cos[32] = cos_sin_cache[q_position, 0:HALF_ROPE]
    load q_sin[32] = cos_sin_cache[q_position, HALF_ROPE:ROPE_DIM]
    load q_front[6,32] = q[0, 0:Q_HEADS, HEAD_DIM-ROPE_DIM:HEAD_DIM-HALF_ROPE]
    load q_back[6,32] = q[0, 0:Q_HEADS, HEAD_DIM-HALF_ROPE:HEAD_DIM]
    compute q_rotated_front = q_front * q_cos - q_back * q_sin
    compute q_rotated_back = q_front * q_sin + q_back * q_cos
    store q tail in place; preserve q[..., 0:HEAD_DIM-ROPE_DIM]
  }

  pipeline each block_id in range(program_block_begin, program_block_end)
      stages PIPELINE_STAGES auto_multibuffer {
    token_base = block_id * TOKEN_BLOCK
    vector token_offsets = arange(0, TOKEN_BLOCK)
    vector token_ids = token_base + token_offsets
    vector token_mask = fp32(token_ids) < fp32(N)

    load position_base_i64 = positions[token_base]
    cast position_base = int32(position_base_i64)
    vector position_ids = position_base + token_offsets
    load cos[64,32] = cos_sin_cache[position_ids, 0:HALF_ROPE]
      mask token_mask as regular contiguous 2D transfer
    load sin[64,32] = cos_sin_cache[position_ids, HALF_ROPE:ROPE_DIM]
      mask token_mask as regular contiguous 2D transfer

    load k_front[64,32] = k[token_ids, 0, HEAD_DIM-ROPE_DIM:HEAD_DIM-HALF_ROPE]
      mask token_mask
    load k_back[64,32] = k[token_ids, 0, HEAD_DIM-HALF_ROPE:HEAD_DIM]
      mask token_mask
    compute k_rotated_front = k_front * cos - k_back * sin
    compute k_rotated_back = k_front * sin + k_back * cos
    store k tail in place with token_mask; preserve k[..., 0:HEAD_DIM-ROPE_DIM]
  }
}

# Layer1 self-check: Q and K use the same FP32 cos/sin arithmetic and BF16 stores as the frozen reference. Only program 0 writes Q, each K token belongs to exactly one consecutive program interval, and the final N=16361 tile is masked. N and ceil_div(N,64) are runtime do-not-specialize values. The host must never select this kernel for BS!=1, discontinuous positions, speculative/decode, or multi-request mirror.

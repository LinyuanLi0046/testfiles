# architecture_decision("decode-prefill-two-path-dispatch", reason="Keep the measured int32 position addressing and revert the rejected load reorder. Decode has N<=64 and grid=N, so every program executes exactly one token; dispatch it to a loop-free kernel. Prefill and mirror retain the general grid-stride kernel required for N up to 16384. Two paths remove decode loop/control overhead without perturbing the accepted prefill implementation.")

sketch welmv4_inplace_rope_npu {
  symbols {
    N: runtime
    BS: runtime
    AIV: runtime_host_constant
    Q_HEADS: constexpr = 6
    K_HEADS: constexpr = 1
    HEAD_DIM: constexpr = 256
    ROPE_DIM: constexpr = 64
    HALF_ROPE: constexpr = 32
  }

  tensors {
    q: bf16[N or BS, Q_HEADS, HEAD_DIM] inplace
    k: bf16[N, K_HEADS, HEAD_DIM] inplace
    positions: int64[N]
    cos_sin_cache: bf16[max_position, ROPE_DIM]
    last_index: optional int64[BS]
  }

  partition {
    if N <= 64 and last_index is absent {
      path = decode_direct
      grid = N
      program token_id = program_id(0)
    } else {
      path = prefill_general
      grid = min(N, AIV * 8)
      program token_start = program_id(0)
      program token_step = num_programs(0)
    }
  }

  decode_direct token_id {
    execute rope_token_body without loop or bounds branch
  }

  prefill_general each token_id in range(token_start, N, token_step) {
    execute rope_token_body
  }

  rope_token_body token_id {
    load pos_i64 = positions[token_id]
    cast pos = int32(pos_i64)
    load cos = cos_sin_cache[pos, 0:HALF_ROPE]
    load sin = cos_sin_cache[pos, HALF_ROPE:ROPE_DIM]

    load k_front = k[token_id, 0:K_HEADS, 0:HALF_ROPE]
    load k_back = k[token_id, 0:K_HEADS, HALF_ROPE:ROPE_DIM]
    compute rotated_k_front = k_front * cos - k_back * sin
    compute rotated_k_back = k_back * cos + k_front * sin
    store k[token_id, 0:K_HEADS, 0:ROPE_DIM] = concat(rotated_k_front, rotated_k_back)

    if last_index is absent {
      load q_front = q[token_id, 0:Q_HEADS, 0:HALF_ROPE]
      load q_back = q[token_id, 0:Q_HEADS, HALF_ROPE:ROPE_DIM]
      compute and store q rotation using cos and sin
    } else if token_id < BS {
      load q_token_i64 = last_index[token_id]
      cast q_token = int32(q_token_i64)
      load q_pos_i64 = positions[q_token]
      cast q_pos = int32(q_pos_i64)
      load q_cos_sin = cos_sin_cache[q_pos, 0:ROPE_DIM]
      load q_front = q[token_id, 0:Q_HEADS, 0:HALF_ROPE]
      load q_back = q[token_id, 0:Q_HEADS, HALF_ROPE:ROPE_DIM]
      load q[token_id, 0:Q_HEADS, 0:ROPE_DIM]
      compute and store q rotation using q_cos_sin
    }
  }
}

# Layer1 self-check: rejected load reordering is fully removed and accepted int32 address narrowing remains. Host dispatch selects decode_direct only for normal-path N<=64, exactly covering required concurrency 1..64; all prefill and mirror cases stay on the previously validated general kernel. Both paths share identical token math and in-place write regions.

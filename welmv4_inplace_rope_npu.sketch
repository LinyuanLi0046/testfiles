# architecture_decision("int32-addressing-and-hoisted-mirror-q", reason="Retain measured-safe int32 position addressing. Mirror last-pass IR places token_id*q_stride outside token_id<BS and executes that branch for every K token even though only program_id<BS performs Q once. Keep the K grid-stride loop pure, then let the first BS programs rotate their one Q row after the loop; normal/decode specialization is unchanged.")

sketch welmv4_inplace_rope_npu {
  symbols {
    N: runtime
    BS: runtime
    AIV: runtime_host_constant
    Q_HEADS: constexpr = 6
    K_HEADS: constexpr = 1
    HEAD_DIM: constexpr = 256
    ROPE_DIM: constexpr = 64
    HALF_ROPE: constexpr = 32
  }

  tensors {
    q: bf16[N or BS, Q_HEADS, HEAD_DIM] inplace
    k: bf16[N, K_HEADS, HEAD_DIM] inplace
    positions: int64[N]
    cos_sin_cache: bf16[max_position, ROPE_DIM]
    last_index: optional int64[BS]
  }

  partition {
    grid = min(N, AIV * 8)
    program token_start = program_id(0)
    program token_step = num_programs(0)
  }

  pipeline each token_id in range(token_start, N, token_step) stages 4 {
    load pos_i64 = positions[token_id]
    cast pos = int32(pos_i64)
    load cos = cos_sin_cache[pos, 0:HALF_ROPE]
    load sin = cos_sin_cache[pos, HALF_ROPE:ROPE_DIM]

    load k_front = k[token_id, 0:K_HEADS, 0:HALF_ROPE]
    load k_back = k[token_id, 0:K_HEADS, HALF_ROPE:ROPE_DIM]
    compute rotated_k_front = k_front * cos - k_back * sin
    compute rotated_k_back = k_back * cos + k_front * sin
    store k[token_id, 0:K_HEADS, 0:ROPE_DIM] = concat(rotated_k_front, rotated_k_back)

    if last_index is absent {
      load q_front = q[token_id, 0:Q_HEADS, 0:HALF_ROPE]
      load q_back = q[token_id, 0:Q_HEADS, HALF_ROPE:ROPE_DIM]
      compute and store q rotation using cos and sin
    }
  }

  if last_index is present and program_id < BS {
      q_row = program_id
      load selected_k_token_i64 = last_index[q_row]
      cast selected_k_token = int32(selected_k_token_i64)
      load q_pos_i64 = positions[selected_k_token]
      cast q_pos = int32(q_pos_i64)
      load q_cos_sin = cos_sin_cache[q_pos, 0:ROPE_DIM]
      load q_front = q[q_row, 0:Q_HEADS, 0:HALF_ROPE]
      load q_back = q[q_row, 0:Q_HEADS, HALF_ROPE:ROPE_DIM]
      compute and store q rotation using q_cos_sin
  }
}

# Layer1 self-check: normal/decode specializes last_index as absent and is byte-for-byte the accepted int32 loop. Mirror still rotates every K token and exactly Q rows 0:BS using the same last_index-selected positions; only the per-token Q branch/address arithmetic is hoisted after the K loop, relying on tested mirror cases where grid >= BS.

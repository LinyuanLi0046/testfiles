# architecture_decision("int32-position-addressing", reason="Retain only the measured-safe narrowing of loaded positions/last_index to int32 before address arithmetic. The IR-driven contiguous-store experiment reduced MTE3 calls but materialized transpose/reshape into five vector functions and UB copies, causing a 2.5x-3.2x prefill regression, so it is fully removed.")

sketch welmv4_inplace_rope_npu {
  symbols {
    N: runtime
    BS: runtime
    AIV: runtime_host_constant
    Q_HEADS: constexpr = 6
    K_HEADS: constexpr = 1
    HEAD_DIM: constexpr = 256
    ROPE_DIM: constexpr = 64
    HALF_ROPE: constexpr = 32
  }

  tensors {
    q: bf16[N or BS, Q_HEADS, HEAD_DIM] inplace
    k: bf16[N, K_HEADS, HEAD_DIM] inplace
    positions: int64[N]
    cos_sin_cache: bf16[max_position, ROPE_DIM]
    last_index: optional int64[BS]
  }

  partition {
    grid = min(N, AIV * 8)
    program token_start = program_id(0)
    program token_step = num_programs(0)
  }

  pipeline each token_id in range(token_start, N, token_step) stages 4 {
    load pos_i64 = positions[token_id]
    cast pos = int32(pos_i64)
    load cos = cos_sin_cache[pos, 0:HALF_ROPE]
    load sin = cos_sin_cache[pos, HALF_ROPE:ROPE_DIM]

    load k_front = k[token_id, 0:K_HEADS, 0:HALF_ROPE]
    load k_back = k[token_id, 0:K_HEADS, HALF_ROPE:ROPE_DIM]
    compute rotated_k_front = k_front * cos - k_back * sin
    compute rotated_k_back = k_back * cos + k_front * sin
    store k[token_id, 0:K_HEADS, 0:ROPE_DIM] = concat(rotated_k_front, rotated_k_back)

    if last_index is absent {
      load q_front = q[token_id, 0:Q_HEADS, 0:HALF_ROPE]
      load q_back = q[token_id, 0:Q_HEADS, HALF_ROPE:ROPE_DIM]
      compute and store q rotation using cos and sin
    } else if token_id < BS {
      load q_token_i64 = last_index[token_id]
      cast q_token = int32(q_token_i64)
      load q_pos_i64 = positions[q_token]
      cast q_pos = int32(q_pos_i64)
      load q_cos_sin = cos_sin_cache[q_pos, 0:ROPE_DIM]
      load q_front = q[token_id, 0:Q_HEADS, 0:HALF_ROPE]
      load q_back = q[token_id, 0:Q_HEADS, HALF_ROPE:ROPE_DIM]
      load q[token_id, 0:Q_HEADS, 0:ROPE_DIM]
      compute and store q rotation using q_cos_sin
    }
  }
}

# Layer1 self-check: the failed contiguous-store experiment is fully removed. The only executable candidate delta from the frozen baseline is narrowing three loaded int64 indices to int32 before pointer arithmetic; decode 1..64, prefill, mirror, math, grid, loop, masks, and in-place regions otherwise remain identical.

# architecture_decision("use-explicit-simd-gather-for-prefill-cache", reason="mayDiscretememaccess removes the 64x2 serial row-copy loops and improves M16384 by 3.19%, but it changes the whole kernel to MIX SIMD/SIMT and reserves 32KB DCache from UB. Replace the hints with gather_out_to_ub, passing cache_rows as a runtime do-not-specialize value, to request the same two 2D gathers through the documented SIMD API without changing FP32 values or dynamic shape semantics.")
# rejected_experiment("retry-exact-prefill-q-as-four-plus-two-after-indirect-gather", reason="The MIX SIMD/SIMT compile still fails: 4+2 requires 2115584 bits (264448B) while only 1769472 bits (221184B) remain after the A5 DCache reservation, exceeding available UB by 43264B. Retain 2+2+2 and do not retry any Q tile wider than two heads under multibuffering.")
# rejected_experiment("merge-exact-prefill-q-as-three-plus-three", reason="It fits UB and reduces 3D Q DMA calls from 6 to 4 and barriers from 5 to 4, but msprof regresses M8192 from 33.472us to 36.068us and M16384 from 56.017us to 59.215us. Three-head tiles have worse vector efficiency than the aligned two-head grouping; retain 2+2+2.")
# architecture_decision("mark-prefill-cache-reads-as-discrete", reason="The A5 last-pass IR scalarizes each [64,32] runtime-position cache gather into 64 serial GM-to-UB row copies, twice per tile for cos and sin. Preserve the FP32 cache, TOKEN_BLOCK=64, Q 2+2+2 split, grid, and runtime shape semantics; mark only these two genuine gather loads with mayDiscretememaccess so the backend can select its discrete-memory path.")
# architecture_decision("restore-a5-prefill-multibuffer-with-smaller-live-q-tiles", reason="Production cos/sin cache is FP32. Disabling A5 auto-multibuffer avoids UB overflow but loses GM-to-UB/Vector overlap and raises M=16384 latency to 62us. Preserve FP32 arithmetic, keep TOKEN_BLOCK=64, split the unmasked Q tile from 4+2 heads to 2+2+2 heads, and explicitly enable multibuffer so each ping-pong stage fits the 248KB A5 UB.")

sketch welmv4_inplace_rope_npu {
  symbols {
    N: runtime_do_not_specialize
    BS: runtime
    AIV: runtime_host_constant
    Q_HEADS: constexpr = 6
    K_HEADS: constexpr = 1
    HEAD_DIM: constexpr = 256
    ROPE_DIM: constexpr = 64
    HALF_ROPE: constexpr = 32
    PREFILL_TOKEN_BLOCK: constexpr = 64
    CACHE_ROWS: runtime_do_not_specialize
  }

  tensors {
    q: bf16[N or BS, Q_HEADS, HEAD_DIM] inplace
    k: bf16[N, K_HEADS, HEAD_DIM] inplace
    positions: int64[N]
    cos_sin_cache: fp32[max_position, ROPE_DIM]
    last_index: optional int64[BS]
  }

  partition shared_decode_and_mirror {
    grid = min(N, AIV * 8)
    program token_start = program_id(0)
    program token_step = num_programs(0)
  }

  partition ordinary_prefill_blocked {
    choose PREFILL_TOKEN_BLOCK = 64 masked when N >= 8192 and N % 64 != 0 else 64 when N % 64 == 0 else 32 when N % 32 == 0 else 16 when N % 16 == 0
    grid = min(ceil_div(N, PREFILL_TOKEN_BLOCK), AIV * 8)
    program block_start = program_id(0)
    program block_step = num_programs(0)
  }

  pipeline each block_id in range(block_start, N / PREFILL_TOKEN_BLOCK, block_step) stages 1 auto_multibuffer {
    vector token_ids = block_id * PREFILL_TOKEN_BLOCK + arange(0, PREFILL_TOKEN_BLOCK)
    vector token_mask = token_ids < N when masked
    load pos_i64[64] = positions[token_ids]
    cast pos[64] = int32(pos_i64)
    gather_out_to_ub cos[64,32] = cos_sin_cache[pos, 0:HALF_ROPE] with index_boundary=CACHE_ROWS and SIMD
    gather_out_to_ub sin[64,32] = cos_sin_cache[pos, HALF_ROPE:ROPE_DIM] with index_boundary=CACHE_ROWS and SIMD

    for K head 0 and each Q head separately when masked {
      load front[64,32] using 2D token-strided DMA and token_mask when masked
      load back[64,32] using 2D token-strided DMA and token_mask when masked
      compute rotated_front = front * cos - back * sin
      compute rotated_back = front * sin + back * cos
      store rotated_front[64,32] using 2D token-strided DMA and token_mask when masked
      store rotated_back[64,32] using 2D token-strided DMA and token_mask when masked
    }

    when unmasked {
      load and rotate K head 0 as [TOKEN_BLOCK,32] 2D tiles
      load and rotate Q heads 0:2 as [TOKEN_BLOCK,2,32] 3D tiles
      load and rotate Q heads 2:4 as [TOKEN_BLOCK,2,32] 3D tiles
      load and rotate Q heads 4:6 as [TOKEN_BLOCK,2,32] 3D tiles
      store all three exact head groups without padding or masks
    }
  }

  pipeline each token_id in range(token_start, N, token_step) stages 4 {
    load pos_i64 = positions[token_id]
    cast pos = int32(pos_i64)
    load cos = cos_sin_cache[pos, 0:HALF_ROPE]
    load sin = cos_sin_cache[pos, HALF_ROPE:ROPE_DIM]

    load k_front = k[token_id, 0:K_HEADS, 0:HALF_ROPE]
    load k_back = k[token_id, 0:K_HEADS, HALF_ROPE:ROPE_DIM]
    compute rotated_k_front = k_front * cos - k_back * sin
    compute rotated_k_back = k_front * sin + k_back * cos
    store k[token_id, 0:K_HEADS, 0:ROPE_DIM] = concat(rotated_k_front, rotated_k_back)

    if last_index is absent {
      load q_front = q[token_id, 0:Q_HEADS, 0:HALF_ROPE]
      load q_back = q[token_id, 0:Q_HEADS, HALF_ROPE:ROPE_DIM]
      compute and store q rotation using the shared multiply-add/sub expressions
    } else if token_id < BS {
      load q_token_i64 = last_index[token_id]
      cast q_token = int32(q_token_i64)
      load q_pos_i64 = positions[q_token]
      cast q_pos = int32(q_pos_i64)
      load q_cos_sin = cos_sin_cache[q_pos, 0:ROPE_DIM]
      load q_front = q[token_id, 0:Q_HEADS, 0:HALF_ROPE]
      load q_back = q[token_id, 0:Q_HEADS, HALF_ROPE:ROPE_DIM]
      compute and store q rotation using the shared multiply-add/sub expressions and q_cos_sin
    }
  }
}

# Layer1 self-check: FP32 cos/sin semantics are preserved; explicit gather changes data movement only. CACHE_ROWS, M, and all sequence-derived quantities remain runtime do-not-specialize values. The exact path retains its measured-best 2+2+2 Q-head split; masked Q remains per-head. Every ordinary-prefill M>=640 uses exact64 or masked64; M=576 exact64 remains the sole lower fast path. Decode and mirror remain on their shared kernel with no mirror-only kernel.

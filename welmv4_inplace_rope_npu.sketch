# architecture_decision("indirect-cache-load-hint", reason="Remote A5 measurement rejected a physical-AIV-only grid by 3.2%-6.6% on the critical prefill shapes, so retain the established token schedule. The remaining position-to-cache address is runtime indirect; mark only those cache loads as potentially discrete so the Ascend compiler can select the appropriate GM-to-UB path without changing math or layout.")

sketch welmv4_inplace_rope_npu {
  symbols {
    N: runtime
    BS: runtime
    AIV: runtime_host_constant
    Q_HEADS: constexpr = 6
    K_HEADS: constexpr = 1
    HEAD_DIM: constexpr = 256
    ROPE_DIM: constexpr = 64
    HALF_ROPE: constexpr = 32
  }

  tensors {
    q: bf16[N or BS, Q_HEADS, HEAD_DIM] inplace
    k: bf16[N, K_HEADS, HEAD_DIM] inplace
    positions: int64[N]
    cos_sin_cache: bf16[max_position, ROPE_DIM]
    last_index: optional int64[BS]
  }

  partition {
    grid = min(N, AIV * 8)
    program token_start = program_id(0)
    program token_step = num_programs(0)
  }

  pipeline each token_id in range(token_start, N, token_step) {
    load pos = positions[token_id]
    load cos = cos_sin_cache[pos, 0:HALF_ROPE]
    hint cos mayDiscretememaccess
    load sin = cos_sin_cache[pos, HALF_ROPE:ROPE_DIM]
    hint sin mayDiscretememaccess

    load k_front = k[token_id, 0:K_HEADS, 0:HALF_ROPE]
    load k_back = k[token_id, 0:K_HEADS, HALF_ROPE:ROPE_DIM]
    compute rotated_k_front = k_front * cos - k_back * sin
    compute rotated_k_back = k_back * cos + k_front * sin
    store k[token_id, 0:K_HEADS, 0:ROPE_DIM] = concat(rotated_k_front, rotated_k_back)

    if last_index is absent {
      load q_front = q[token_id, 0:Q_HEADS, 0:HALF_ROPE]
      load q_back = q[token_id, 0:Q_HEADS, HALF_ROPE:ROPE_DIM]
      compute and store q rotation using cos and sin
    } else if token_id < BS {
      load q_token = last_index[token_id]
      load q_pos = positions[q_token]
      load q_cos_sin = cos_sin_cache[q_pos, 0:ROPE_DIM]
      hint q_cos_sin mayDiscretememaccess
      load q[token_id, 0:Q_HEADS, 0:ROPE_DIM]
      compute and store q rotation using q_cos_sin
    }
  }
}

# Layer1 self-check: the rejected physical-AIV partition is fully restored. The only candidate delta is a compiler hint on loads whose base address contains a runtime value loaded from positions/last_index; deterministic Q/K loads and every store remain unhinted. Q/K writes are disjoint by token/head, no reduction or synchronization exists, and head_dim=256/rope_dim=64/head counts/strides remain compile-time constants.

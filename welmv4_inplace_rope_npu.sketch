# architecture_decision("four-token-vectorization", reason="A5 (950) has a 256-byte vector width. Four BF16 tokens across one 32-element RoPE half form exactly 256 bytes, so batch four independent tokens into one vector program. This removes fourfold scalar token-loop/control overhead while keeping each Q/K/cache access masked and preserving the empirically better oversubscribed schedule.")

sketch welmv4_inplace_rope_npu {
  symbols {
    N: runtime
    BS: runtime
    AIV: runtime_host_constant
    Q_HEADS: constexpr = 6
    K_HEADS: constexpr = 1
    HEAD_DIM: constexpr = 256
    ROPE_DIM: constexpr = 64
    HALF_ROPE: constexpr = 32
    TOKEN_BLOCK: constexpr = 4
  }

  tensors {
    q: bf16[N or BS, Q_HEADS, HEAD_DIM] inplace
    k: bf16[N, K_HEADS, HEAD_DIM] inplace
    positions: int64[N]
    cos_sin_cache: bf16[max_position, ROPE_DIM]
    last_index: optional int64[BS]
  }

  partition {
    grid = min(ceil_div(N, TOKEN_BLOCK), AIV * 8)
    program token_start = program_id(0) * TOKEN_BLOCK
    program token_step = num_programs(0) * TOKEN_BLOCK
  }

  pipeline each token_base in range(token_start, N, token_step) {
    vector token_ids = token_base + arange(0, TOKEN_BLOCK)
    vector token_mask = token_ids < N
    load pos[TOKEN_BLOCK] = positions[token_ids] masked token_mask
    load cos[TOKEN_BLOCK, HALF_ROPE] = cos_sin_cache[pos, 0:HALF_ROPE]
    load sin[TOKEN_BLOCK, HALF_ROPE] = cos_sin_cache[pos, HALF_ROPE:ROPE_DIM]

    load k_front = k[token_ids, 0:K_HEADS, 0:HALF_ROPE] masked token_mask
    load k_back = k[token_ids, 0:K_HEADS, HALF_ROPE:ROPE_DIM] masked token_mask
    compute rotated_k_front = k_front * cos - k_back * sin
    compute rotated_k_back = k_back * cos + k_front * sin
    store k[token_id, 0:K_HEADS, 0:ROPE_DIM] = concat(rotated_k_front, rotated_k_back)

    if last_index is absent {
      load q_front = q[token_ids, 0:Q_HEADS, 0:HALF_ROPE] masked token_mask
      load q_back = q[token_ids, 0:Q_HEADS, HALF_ROPE:ROPE_DIM] masked token_mask
      compute and store q rotation using cos and sin
    } else {
      vector q_mask = token_mask and token_ids < BS
      load q_token = last_index[token_ids] masked q_mask
      load q_pos = positions[q_token] masked q_mask
      load q_cos_sin = cos_sin_cache[q_pos, 0:ROPE_DIM]
      load q[token_ids, 0:Q_HEADS, 0:ROPE_DIM] masked q_mask
      compute and store q rotation using q_cos_sin
    }
  }
}

# Layer1 self-check: failed #3 and #4 changes are fully removed. This round changes only scalar-token work into TOKEN_BLOCK=4 vectors; decode M=1..64 is covered with masks, mirror Q uses a separate vector q_mask, and K still covers every N token. Q/K writes remain disjoint, no reduction/synchronization is introduced, and head_dim=256/rope_dim=64/head counts/strides/TOKEN_BLOCK are compile-time constants.

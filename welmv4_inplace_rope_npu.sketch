# architecture_decision("blocked-2d-ordinary-prefill", reason="Keep decode and mirror on the shared int32-addressing kernel; do not create a mirror-only kernel. Split only ordinary prefill when N is divisible by 16. The prior masked four-token 3D tile lowered catastrophically (0.29x-0.36x), so use sixteen-token 2D tiles per real head instead: one [16,32] GM/UB transfer for each RoPE half, explicit static expansion of exactly six Q heads, no token-tail mask, and fallback to the shared kernel for non-divisible N. This targets the last-pass IR bottleneck of per-token DMA calls, barriers, and the padded 8-head vector loop; grid-only and formula changes below 3% remain rejected.")

sketch welmv4_inplace_rope_npu {
  symbols {
    N: runtime
    BS: runtime
    AIV: runtime_host_constant
    Q_HEADS: constexpr = 6
    K_HEADS: constexpr = 1
    HEAD_DIM: constexpr = 256
    ROPE_DIM: constexpr = 64
    HALF_ROPE: constexpr = 32
    PREFILL_TOKEN_BLOCK: constexpr = 16
  }

  tensors {
    q: bf16[N or BS, Q_HEADS, HEAD_DIM] inplace
    k: bf16[N, K_HEADS, HEAD_DIM] inplace
    positions: int64[N]
    cos_sin_cache: bf16[max_position, ROPE_DIM]
    last_index: optional int64[BS]
  }

  partition shared_decode_and_mirror {
    grid = min(N, AIV * 8)
    program token_start = program_id(0)
    program token_step = num_programs(0)
  }

  partition ordinary_prefill_divisible_16 {
    grid = min(N / PREFILL_TOKEN_BLOCK, AIV * 8)
    program block_start = program_id(0)
    program block_step = num_programs(0)
  }

  pipeline each block_id in range(block_start, N / PREFILL_TOKEN_BLOCK, block_step) stages 4 {
    vector token_ids = block_id * PREFILL_TOKEN_BLOCK + arange(0, PREFILL_TOKEN_BLOCK)
    load pos_i64[16] = positions[token_ids]
    cast pos[16] = int32(pos_i64)
    load cos[16,32] = cos_sin_cache[pos, 0:HALF_ROPE]
    load sin[16,32] = cos_sin_cache[pos, HALF_ROPE:ROPE_DIM]

    for each real head in [K head 0, Q heads 0..5] statically {
      load front[16,32] using 2D token-strided DMA
      load back[16,32] using 2D token-strided DMA
      compute rotated_front = front * cos - back * sin
      compute rotated_back = front * sin + back * cos
      store rotated_front[16,32] using 2D token-strided DMA
      store rotated_back[16,32] using 2D token-strided DMA
    }
  }

  pipeline each token_id in range(token_start, N, token_step) stages 4 {
    load pos_i64 = positions[token_id]
    cast pos = int32(pos_i64)
    load cos = cos_sin_cache[pos, 0:HALF_ROPE]
    load sin = cos_sin_cache[pos, HALF_ROPE:ROPE_DIM]

    load k_front = k[token_id, 0:K_HEADS, 0:HALF_ROPE]
    load k_back = k[token_id, 0:K_HEADS, HALF_ROPE:ROPE_DIM]
    compute rotated_k_front = k_front * cos - k_back * sin
    compute rotated_k_back = k_front * sin + k_back * cos
    store k[token_id, 0:K_HEADS, 0:ROPE_DIM] = concat(rotated_k_front, rotated_k_back)

    if last_index is absent {
      load q_front = q[token_id, 0:Q_HEADS, 0:HALF_ROPE]
      load q_back = q[token_id, 0:Q_HEADS, HALF_ROPE:ROPE_DIM]
      compute and store q rotation using the shared multiply-add/sub expressions
    } else if token_id < BS {
      load q_token_i64 = last_index[token_id]
      cast q_token = int32(q_token_i64)
      load q_pos_i64 = positions[q_token]
      cast q_pos = int32(q_pos_i64)
      load q_cos_sin = cos_sin_cache[q_pos, 0:ROPE_DIM]
      load q_front = q[token_id, 0:Q_HEADS, 0:HALF_ROPE]
      load q_back = q[token_id, 0:Q_HEADS, HALF_ROPE:ROPE_DIM]
      compute and store q rotation using the shared multiply-add/sub expressions and q_cos_sin
    }
  }
}

# Layer1 self-check: decode and mirror share the original candidate kernel and dispatch; there is no dedicated mirror kernel. Only ordinary prefill with N divisible by 16 uses the new kernel. It processes all tokens exactly once, expands exactly six Q heads plus one K head, preserves BF16 loads/stores and FP32 arithmetic promotion, and falls back for all tail shapes. The unstable 224-program dispatch, masked 3D token tile, merged-store materialization, and explicit FMA are absent.

# architecture_decision("prefetch-q2-across-k-plus-q4", reason="Retain runtime do_not_specialize shapes, the accepted tl.range/stages=4 pipeline, 64-token tile, masked path, and K+Q4 source adjacency. In unmasked prefill, issue the two Q2 3D half-tail loads before K+Q4, keep those BF16 tiles live across the accepted merged K+Q4 vector function, then compute/store Q2. A5 profiling reports MTE2 about 61.2%/27.2 us versus vector 36.9%/16.4 us and MTE3 13.9%/6.2 us, so this explicitly trades UB lifetime for load overlap without changing bytes, DMA count, addresses, math, shape cache keys, or writers. Reject unless critical latency improves by more than 3% and IR preserves K+Q4 fusion.")

sketch welmv4_inplace_rope_npu {
  symbols {
    N: runtime_do_not_specialize
    BS: runtime
    AIV: runtime_host_constant
    Q_HEADS: constexpr = 6
    K_HEADS: constexpr = 1
    HEAD_DIM: constexpr = 256
    ROPE_DIM: constexpr = 64
    HALF_ROPE: constexpr = 32
    PREFILL_TOKEN_BLOCK: constexpr = 64
  }

  tensors {
    q: bf16[N or BS, Q_HEADS, HEAD_DIM] inplace
    k: bf16[N, K_HEADS, HEAD_DIM] inplace
    positions: int64[N]
    cos_sin_cache: bf16[max_position, ROPE_DIM]
    last_index: optional int64[BS]
  }

  partition shared_decode_and_mirror {
    grid = min(N, AIV * 8)
    program token_start = program_id(0)
    program token_step = num_programs(0)
  }

  partition ordinary_prefill_blocked {
    choose PREFILL_TOKEN_BLOCK = 64 masked when N >= 8192 and N % 64 != 0 else 64 when N % 64 == 0 else 32 when N % 32 == 0 else 16 when N % 16 == 0
    grid = min(ceil_div(N, PREFILL_TOKEN_BLOCK), AIV * 8)
    program block_start = program_id(0)
    program block_step = num_programs(0)
  }

  pipeline each block_id in range(block_start, N / PREFILL_TOKEN_BLOCK, block_step) stages 4 {
    vector token_ids = block_id * PREFILL_TOKEN_BLOCK + arange(0, PREFILL_TOKEN_BLOCK)
    vector token_mask = token_ids < N when masked
    load pos_i64[64] = positions[token_ids]
    cast pos[64] = int32(pos_i64)
    load cos[64,32] = cos_sin_cache[pos, 0:HALF_ROPE]
    load sin[64,32] = cos_sin_cache[pos, HALF_ROPE:ROPE_DIM]

    for K head 0 and each Q head separately when masked {
      load front[64,32] using 2D token-strided DMA and token_mask when masked
      load back[64,32] using 2D token-strided DMA and token_mask when masked
      compute rotated_front = front * cos - back * sin
      compute rotated_back = front * sin + back * cos
      store rotated_front[64,32] using 2D token-strided DMA and token_mask when masked
      store rotated_back[64,32] using 2D token-strided DMA and token_mask when masked
    }

    when unmasked {
      prefetch Q heads 4:6 front/back as [TOKEN_BLOCK,2,32] 3D tiles
      load and rotate K head 0 as [TOKEN_BLOCK,32] 2D tiles
      load and rotate Q heads 0:4 as [TOKEN_BLOCK,4,32] 3D tiles
      rotate and store the prefetched Q heads 4:6 tiles
      store both exact head groups without padding or masks
    }
  }

  pipeline each token_id in range(token_start, N, token_step) stages 4 {
    load pos_i64 = positions[token_id]
    cast pos = int32(pos_i64)
    load cos = cos_sin_cache[pos, 0:HALF_ROPE]
    load sin = cos_sin_cache[pos, HALF_ROPE:ROPE_DIM]

    load k_front = k[token_id, 0:K_HEADS, 0:HALF_ROPE]
    load k_back = k[token_id, 0:K_HEADS, HALF_ROPE:ROPE_DIM]
    compute rotated_k_front = k_front * cos - k_back * sin
    compute rotated_k_back = k_front * sin + k_back * cos
    store k[token_id, 0:K_HEADS, 0:ROPE_DIM] = concat(rotated_k_front, rotated_k_back)

    if last_index is absent {
      load q_front = q[token_id, 0:Q_HEADS, 0:HALF_ROPE]
      load q_back = q[token_id, 0:Q_HEADS, HALF_ROPE:ROPE_DIM]
      compute and store q rotation using the shared multiply-add/sub expressions
    } else if token_id < BS {
      load q_token_i64 = last_index[token_id]
      cast q_token = int32(q_token_i64)
      load q_pos_i64 = positions[q_token]
      cast q_pos = int32(q_pos_i64)
      load q_cos_sin = cos_sin_cache[q_pos, 0:ROPE_DIM]
      load q_front = q[token_id, 0:Q_HEADS, 0:HALF_ROPE]
      load q_back = q[token_id, 0:Q_HEADS, HALF_ROPE:ROPE_DIM]
      compute and store q rotation using the shared multiply-add/sub expressions and q_cos_sin
    }
  }
}

# Layer1 self-check: decode and mirror remain shared and unchanged. N and num_token_blocks stay runtime do_not_specialize. Masked prefill exactly keeps the accepted path. Unmasked Q2 loads move earlier but use the same q_data+4*head_dim addresses; their computations and stores remain after K+Q4 and are algebraically identical. Every Q/K tail still has one reader/writer, with unchanged grid, stages, masks, byte counts, and output values.

# architecture_decision("one-ordinary-prefill-jit", reason="Contiguous single-request and segmented multi-request Prefill share one launched JIT. Runtime metadata chooses the position-tile source and full/tail path without adding a cache-key variant. All runtime-changing scalar arguments are do_not_specialize; only the fixed WeLM/A5 tile contract is compile-time code.")
# optimization_point("physical-aiv-contiguous-tile-partition", skill_point="mixed_strategy", reason="Retain both semantic strategies inside one binary, cap the one-dimensional grid at the detected vector-core count, and give each AIV one consecutive interval.")

sketch welmv4_inplace_rope_prefill {
  symbols {
    N: runtime_do_not_specialize
    NUM_WORK_TILES: runtime_do_not_specialize
    Q_TOKEN_STRIDE: runtime_do_not_specialize
    K_TOKEN_STRIDE: runtime_do_not_specialize
    HAS_SEGMENTS: runtime_do_not_specialize in {0, 1}
    AIV: runtime_host_constant
    HEAD_DIM: fixed_model_literal = 256
    ROPE_DIM: fixed_model_literal = 64
    HALF_ROPE: fixed_model_literal = 32
    Q_HEADS: fixed_model_literal = 6
    TOKEN_BLOCK: fixed_model_literal = 64
  }

  tensors {
    q: bf16[N, 6, 256] inplace
    k: bf16[N, 1, 256] inplace
    positions: int64[N]
    cos_sin_cache: fp32[max_position, 64]
    segment_tile_starts: int32[NUM_WORK_TILES + 1] or stable_placeholder
  }

  constraints {
    q and k token strides are passed at runtime
    when HAS_SEGMENTS == 0:
      NUM_WORK_TILES = ceil_div(N, 64)
      positions are contiguous over the complete packed interval
      segment_tile_starts is not dereferenced
    when HAS_SEGMENTS == 1:
      each [segment_tile_starts[t], segment_tile_starts[t+1]) is request-local
      each tile length is in [1, 64]
      positions are contiguous inside each tile
  }

  partition {
    grid = min(NUM_WORK_TILES, detected_AIV)
    TILES_PER_PROGRAM = ceil_div(NUM_WORK_TILES, grid)
    tile_begin = program_id(0) * TILES_PER_PROGRAM
    tile_end = min(tile_begin + TILES_PER_PROGRAM, NUM_WORK_TILES)
  }

  pipeline each tile_id in range(tile_begin, tile_end) stages 1 auto_multibuffer {
    runtime when HAS_SEGMENTS != 0:
      token_base = segment_tile_starts[tile_id]
      token_end = segment_tile_starts[tile_id + 1]
    runtime otherwise:
      token_base = tile_id * 64
      token_end = min(token_base + 64, N)

    token_count = token_end - token_base
    position_base = int32(positions[token_base])
    position_ids = position_base + arange(0, 64)

    runtime when fp32(token_count) >= 64:
      load cos/sin and K as unmasked [64,32] regular 2D DMA
      rotate K tail in FP32 and store BF16 in place
      rotate Q heads as exact 2+2+2 groups without padding
    runtime otherwise:
      token_mask = fp32(arange(0,64)) < fp32(token_count)
      load/store cos/sin, K, and Q 2+2+2 with token_mask
      rotate with the identical FP32 multiply-add/sub expressions
  }
}

# Layer1 self-check: There is one ordinary Prefill launch function. N, work-tile count, both token strides, and HAS_SEGMENTS are normal int arguments and exactly match do_not_specialize. No shape-derived tl.constexpr or masked meta-parameter exists. Every token belongs to one tile; segment tiles never cross a position discontinuity; full and tail branches use identical addresses and arithmetic for valid lanes.

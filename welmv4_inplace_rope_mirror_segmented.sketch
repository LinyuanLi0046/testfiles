# architecture_decision("benchmark-segmented-mirror-before-framework-integration", reason="This candidate remains testfiles-only until correctness and authoritative msprof prove a meaningful gain over the frozen generic mirror kernel. Existing BS=1 mirror and ordinary prefill providers remain frozen regression groups.")
# optimization_point("physical-aiv-contiguous-segment-tile-partition", skill_point="vector_core_partition", reason="The generic mirror kernel processes K one token at a time with hundreds of interleaved programs. Build request-local 64-token tiles, cap the grid at the physical AIV count, and give each AIV one consecutive tile interval. This is the only latency-skill optimization in the first multi-BS validation round.")

sketch welmv4_inplace_rope_segmented_mirror {
  symbols {
    N: runtime = sum(SEGMENT_LENGTHS)
    BS: runtime_do_not_specialize
    NUM_SEGMENT_TILES: runtime_do_not_specialize
      = sum(ceil_div(SEGMENT_LENGTHS[b], TOKEN_BLOCK) for b in 0:BS)
    AIV: runtime_host_constant = 56 on Ascend 950
    Q_HEADS: constexpr = 6
    K_HEADS: constexpr = 1
    HEAD_DIM: constexpr = 256
    ROPE_DIM: constexpr = 64
    HALF_ROPE: constexpr = 32
    TOKEN_BLOCK: constexpr = 64
    PIPELINE_STAGES: constexpr = 1
  }

  tensors {
    q: bf16[BS, Q_HEADS, HEAD_DIM] inplace contiguous
    k: bf16[N, K_HEADS, HEAD_DIM] inplace contiguous
    positions: int64[N]
    cos_sin_cache: fp32[max_position, ROPE_DIM]
    last_index: int64[BS]
    segment_tile_starts: int32[NUM_SEGMENT_TILES + 1]
  }

  constraints {
    requests occupy consecutive packed token intervals
    last_index[b] = sum(SEGMENT_LENGTHS[0:b+1]) - 1
    positions are contiguous only inside each request interval
    segment_tile_starts contains every request-local tile start plus terminal N
    0 < segment_tile_starts[t+1] - segment_tile_starts[t] <= TOKEN_BLOCK
    no segment tile crosses a request boundary
    q row b uses positions[last_index[b]]
    k token i uses positions[i]
    BS in {2, 4, 8, 16, 32, 64, 128} for the first benchmark suite
  }

  partition requests_contiguously {
    grid = min(max(NUM_SEGMENT_TILES, BS), AIV)
    REQUESTS_PER_PROGRAM = ceil_div(BS, grid)
    request_begin = program_id(0) * REQUESTS_PER_PROGRAM
    request_end = min(request_begin + REQUESTS_PER_PROGRAM, BS)
  }

  each request_id in range(request_begin, request_end) {
    load q_source = int32(last_index[request_id])
    load q_position = int32(positions[q_source])
    load q_cos[32] = cos_sin_cache[q_position, 0:HALF_ROPE]
    load q_sin[32] = cos_sin_cache[q_position, HALF_ROPE:ROPE_DIM]
    load q_front[6,32], q_back[6,32] from q[request_id]
    compute q_rotated_front = q_front * q_cos - q_back * q_sin
    compute q_rotated_back = q_front * q_sin + q_back * q_cos
    store q tail in place; preserve q[..., 0:HEAD_DIM-ROPE_DIM]
  }

  partition segment_tiles_contiguously {
    TILES_PER_PROGRAM = ceil_div(NUM_SEGMENT_TILES, grid)
    tile_begin = program_id(0) * TILES_PER_PROGRAM
    tile_end = min(tile_begin + TILES_PER_PROGRAM, NUM_SEGMENT_TILES)
  }

  pipeline each tile_id in range(tile_begin, tile_end)
      stages PIPELINE_STAGES auto_multibuffer {
    token_base = segment_tile_starts[tile_id]
    token_end = segment_tile_starts[tile_id + 1]
    token_count = token_end - token_base
    vector token_offsets = arange(0, TOKEN_BLOCK)
    load position_base = int32(positions[token_base])
    vector position_ids = position_base + token_offsets

    when fp32(token_count) >= fp32(TOKEN_BLOCK) {
      load cos[64,32], sin[64,32] without mask as regular contiguous 2D DMA
      load k_front[64,32], k_back[64,32] without mask as regular 2D DMA
      compute and store both rotated K halves without mask
    } otherwise request_tail {
      vector token_mask = fp32(token_offsets) < fp32(token_count)
      load cos, sin, k_front, k_back with token_mask
      compute and store both rotated K halves with token_mask
    }
    preserve k[..., 0:HEAD_DIM-ROPE_DIM]
  }
}

# Layer1 self-check: Every Q request row has one writer and takes its position from that request's last token. Every K token belongs to exactly one request-local tile, tiles never cross a position discontinuity, and full tiles use unmasked regular 2D accesses. BS and the derived segment-tile count are runtime do-not-specialize values. The grid is one-dimensional and never exceeds physical AIV count. No framework file is modified by this experiment.
